# Copy to .env for live email mode. Never commit the .env file.
AGENT_EMAIL=
# imap-smtp uses an app password. gmail-api uses Google sign-in instead.
EMAIL_TRANSPORT=imap-smtp
EMAIL_PASSWORD=
GOOGLE_CLIENT_FILE=.secrets/google-client.json
GOOGLE_TOKEN_FILE=.secrets/google-token.json
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
POLL_SECONDS=20
# Optional: comma-separated sender addresses allowed to use the live worker.
ALLOWED_SENDERS=

# LLM_PROVIDER: none, openai-compatible, or ollama.
# The OpenAI-compatible provider interprets every valid single-matter request.
LLM_PROVIDER=none
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=swift
LLM_API_KEY=
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=45

# Optional legacy Ollama fallback for unusual phrasing when selected as provider.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
