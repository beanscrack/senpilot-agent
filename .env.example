# Copy to .env for live email mode. Never commit the .env file.
AGENT_EMAIL=
# imap-smtp uses an app password. gmail-api uses Google sign-in instead.
EMAIL_TRANSPORT=imap-smtp
EMAIL_PASSWORD=
GOOGLE_CLIENT_FILE=.secrets/google-client.json
GOOGLE_TOKEN_FILE=.secrets/google-token.json
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
POLL_SECONDS=20
# Optional: comma-separated sender addresses allowed to use the live worker.
ALLOWED_SENDERS=

# Optional local LLM for request phrasing outside the built-in aliases.
# No API key required. Install Ollama and pull your chosen model first.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
